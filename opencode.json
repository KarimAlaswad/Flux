{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "rm *": "deny",
      "git *": "ask",
    },
    "edit": {
      "*": "deny",
      "*.md": "allow",
      "**/*.md": "allow",
      ".scratch/**/*": "allow",
      "lessons/*.html": "allow",
      "assets/*": "allow",
      "reference/*.html": "allow"
    }
  }
}
