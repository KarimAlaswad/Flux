{
  "name": "flux",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#shared/*": "./plugins/_shared/*"
  },
  "scripts": {
    "dev": "bun run build:plugins && bunx vite build && cargo run --manifest-path src-tauri-webui/Cargo.toml",
    "build": "bun run build:plugins && tauri build",
