    "tauri": "tauri"
  },
  "dependencies": {
    "@steipete/sweet-cookie": "^0.4.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "movi-player": "^0.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
